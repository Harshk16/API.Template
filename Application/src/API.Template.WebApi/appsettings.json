{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Configuration": {
    "UseUserSecrets": false,
    "UseKeyVault": true,
    "UseDatabaseSettings": true
  },

  "AzureKeyVault": { "ReloadIntervalMinutes": 15 },
  "Database": {
    "Provider": "SqlServer",
    "CommandTimeoutSeconds": 30
  },
  "Identity": {
    "RequireConfirmedEmail": false,
    "EnableSecurityStampValidation": true

  },
  "ExternalApi": { "TimeoutSeconds": 30 },
  "AppRuntimeSettings": { "ReloadIntervalSeconds": 300 }
}