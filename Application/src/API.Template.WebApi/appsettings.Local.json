{
  "Environment": "Local",
  "Configuration": {
    "UseUserSecrets": true,
    "UseKeyVault": false,
    "UseDatabaseSettings": true
  },

  "AzureKeyVault": {
    "VaultUri": "https://kv-api-template-dev.vault.azure.net/",
  },

  "ExternalApi": {
    "BaseUrl": "https://external-service.com"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}