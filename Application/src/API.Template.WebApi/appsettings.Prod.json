{
  "Application": {
    "EnvironmentName": "Production"
  },

  "Configuration": {
    "UseUserSecrets": false,
    "UseKeyVault": true,
    "UseEnvironmentVariables": true,
    "UseDatabaseSettings": true,
    "UseAzureAppConfiguration": true
  },

  "Database": {
    "ConnectionString": "Production Connection"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}