{
  "Application": {
    "EnvironmentName": "QA"
  },

  "Configuration": {
    "UseUserSecrets": false,
    "UseKeyVault": true,
    "UseEnvironmentVariables": true,
    "UseDatabaseSettings": false,
    "UseAzureAppConfiguration": false
  },

  //"Database": {
  //  "ConnectionString": "QA",
  //  "Provider": "SqlServer"
  //},

  "Database": {
    "Provider": "SqlServer",
    "CommandTimeout": 30,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 30
  },

  "KeyVault": {
    "VaultUri": "https://kv-api-template-qa.vault.azure.net/"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}