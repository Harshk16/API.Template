{
  "$schema": "http://json.schemastore.org/launchsettings.json",

  // Settings used only when running with IIS Express locally.
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:19393",
      "sslPort": 44310
    }
  },

  "profiles": {

    // Runs the application using Kestrel over HTTP.
    // Useful if HTTPS is not required.
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:5201",

      // Determines which appsettings.{Environment}.json file is loaded.
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Dev"
      }
    },

    // Runs the application using Kestrel over HTTPS.
    // This is the profile we normally use during development.
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "launchUrl": "swagger",

      // HTTPS and HTTP endpoints exposed by the application.
      "applicationUrl": "https://localhost:7021;http://localhost:5201",

      // Local -> appsettings.Local.json
      // QA -> appsettings.QA.json
      // Production -> appsettings.Production.json
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Dev"
      }
    },

    // Starts the application using IIS Express instead of Kestrel.
    // Mainly useful for Visual Studio compatibility.
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": false,
      "launchUrl": "swagger",

      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Dev"
      }
    }
  }
}